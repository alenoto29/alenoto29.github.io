3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Call intelligence — Alessandro Noto"}],["$","meta","1",{"name":"description","content":"I used AI to analyse why people called, linked those reasons to conversion outcomes, and proposed changes to phone routing. My manager approved the recommendations, which were implemented alongside operator training."}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","meta","3",{"property":"og:title","content":"Call intelligence — Alessandro Noto"}],["$","meta","4",{"property":"og:description","content":"I used AI to analyse why people called, linked those reasons to conversion outcomes, and proposed changes to phone routing. My manager approved the recommendations, which were implemented alongside operator training."}],["$","meta","5",{"name":"twitter:card","content":"summary"}],["$","meta","6",{"name":"twitter:title","content":"Call intelligence — Alessandro Noto"}],["$","meta","7",{"name":"twitter:description","content":"I used AI to analyse why people called, linked those reasons to conversion outcomes, and proposed changes to phone routing. My manager approved the recommendations, which were implemented alongside operator training."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["projects","call-intelligence"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"projects","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"children":["$","$Lb",null,{"children":["$","$Lc",null,{"children":[["$","$L8",null,{"providerId":"page:/projects/call-intelligence","segmentMap":{"children":["__PAGE__"]},"children":["$","$L9",null,{"id":"page:/projects/call-intelligence"}]}],null]}]}]}]}]}]}]}],null,null]
1:[["$","a",null,{"className":"skip-link","href":"#case","children":"Skip to case study"}],["$","header",null,{"className":"nav","children":[["$","a",null,{"className":"brand","href":"/","children":"Alessandro Noto"}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"/#projects","children":"All projects ↗"}],["$","a",null,{"href":"/#about","children":"About"}]]}],["$","span",null,{"className":"edition","children":["CASE / 0",1]}]]}],["$","main",null,{"id":"case","className":"case-page","children":[["$","a",null,{"className":"back-link","href":"/#projects","children":"← Back to projects"}],["$","p",null,{"className":"eyebrow","children":["0",1," / ","LANGUAGE → INSIGHT"]}],["$","h1",null,{"children":"Call intelligence"}],["$","p",null,{"className":"case-lead","children":"I used AI to analyse why people called, linked those reasons to conversion outcomes, and proposed changes to phone routing. My manager approved the recommendations, which were implemented alongside operator training."}],["$","div",null,{"className":"case-facts","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"MATURITY"}],["$","p",null,{"children":"Applied recommendations"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"SUPPORTED OUTCOME"}],["$","p",null,{"children":"Used to inform routing changes"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"CONTRIBUTION"}],["$","p",null,{"children":"Built and analysed with AI assistance"}]]}]]}],["$","article",null,{"className":"case-story","children":[["$","h2",null,{"children":"The story"}],[["$","p","0",{"children":"Inbound callers were reaching parts of a phone service that did not match what they needed. The routing menu lacked a systematic view of why people were calling, leaving operators to handle the mismatch. During my internship, I was assigned the problem and chose to investigate it through AI-assisted transcript analysis."}],["$","p","1",{"children":"My main analytical decision was to classify intent from the opening of each call. Later in a conversation, an operator may introduce an offer or steer the discussion. Using the whole transcript to identify the original reason for calling could confuse that later discussion with the caller's initial need. The opening was more relevant to a routing decision made before the operator conversation."}],["$","p","2",{"children":"I used AI to classify those opening intents, then linked the classifications to recorded conversion outcomes. This let me compare reasons for calling against what happened afterwards and propose which routing options to prioritise. For non-converted calls, I also used the model to identify possible barriers and turning points in the conversation. These were interpretations to review, and several barriers could appear in the same call."}],["$","p","3",{"children":"I excluded transcripts that were too illegible to interpret and manually compared a sample of the remaining calls with the AI's findings. The checks broadly supported the analysis, but I did not record the sample size or selection method, so I cannot claim measured accuracy. Some transcripts remained too unclear to assess."}],["$","p","4",{"children":"I discussed the report and proposed priorities with my manager, who made the final decision on operational changes. The recommendations were applied alongside operator training. My contribution was the choice of approach, the analytical framing and the analysis informing that decision; AI supported classification, pattern extraction and report drafting."}],["$","p","5",{"children":"The clearest outcome was that the analysis informed changes to the phone flow. The subsequent before-and-after comparison could not establish a causal effect: the periods differed seasonally, training accompanied the routing changes, and there was no control group."}]]]}],"$Ld","$Le"]}],"$Lf"]
d:["$","aside",null,{"className":"case-question","children":[["$","span",null,{"className":"eyebrow","children":"A CONVERSATION WORTH HAVING"}],["$","p",null,{"children":"Why I classified intent from the call opening, then used the conversion outcome and later conversation to investigate what happened next."}]]}]

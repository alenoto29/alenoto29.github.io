1:[["$","a",null,{"className":"skip-link","href":"#case","children":"Skip to case study"}],["$","header",null,{"className":"nav","children":[["$","a",null,{"className":"brand","href":"/","children":"Alessandro Noto"}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"/#projects","children":"All projects ↗"}],["$","a",null,{"href":"/#about","children":"About"}]]}]]}],["$","main",null,{"id":"case","className":"case-page","children":[["$","a",null,{"className":"back-link","href":"/#projects","children":"← Back to projects"}],["$","h1",null,{"children":"SEO content operations"}],["$","p",null,{"className":"case-subtitle","children":"Less repetitive work. More time for SEO."}],["$","p",null,{"className":"case-lead","children":"A collection of tools for checking pages, keeping offer data current and tracking keywords. Built around the work an SEO team needs to do every week."}],["$","div",null,{"className":"case-art","children":["$","img",null,{"src":"/images/projects/forecasting.webp","width":"1536","height":"1024","alt":""}]}],["$","article",null,{"className":"case-story","children":[[["$","section","What changed",{"children":[["$","h2",null,{"children":"What changed"}],[["$","p","0",{"children":[["$","$d","0",{"children":"Preparing pages, checking content and updating prices took a lot of manual work. I built workflows for those recurring tasks, from a page checker and reusable WordPress components to offer updates and keyword tracking."}]]}],["$","p","1",{"children":[["$","$d","0",{"children":""}],["$","strong","1",{"children":"The page checker and component library became tools the whole SEO team could use independently."}],["$","$d","2",{"children":" Together, these processes saved a considerable amount of time and made it easier to focus on higher-priority work. Page updates still went through review before I uploaded them to WordPress."}]]}]]]}],["$","section","Results",{"children":[["$","h2",null,{"children":"Results"}],[["$","p","0",{"children":[["$","$d","0",{"children":"After the March search update, "}],["$","strong","1",{"children":"clicks and impressions for these pages fell by around 50%"}],["$","$d","2",{"children":". Both have since grown past their pre-update levels. These are results I observed while working on the pages; the workflows were part of a wider SEO effort, so I can’t isolate their effect on traffic."}]]}]]]}]],["$","details",null,{"className":"case-technical","children":[["$","summary",null,{"children":"Under the hood"}],[["$","p","0",{"children":[["$","$d","0",{"children":"Choose a project below to see its inputs, steps and outputs. Each tool handles a different part of the process, with review before changes reach a live site."}]]}]]]}]]}],false,"$undefined",["$","div",null,{"className":"case-next","children":[["$","span",null,{"className":"eyebrow","children":"NEXT PROJECT"}],["$","a",null,{"href":"/projects/paid-reporting","children":["Paid acquisition reporting"," ↗"]}]]}]]}],["$","footer",null,{"className":"footer","children":[["$","a",null,{"href":"/","children":"Alessandro Noto"}],["$","a",null,{"href":"/#contact","children":"Let’s talk ↗"}],["$","a",null,{"href":"/#projects","children":"All projects"}]]}]]

3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Model evaluations — Alessandro Noto"}],["$","meta","1",{"name":"description","content":"I built a repeatable evaluation suite around SEO tasks I actually do. It helped me choose lower-cost models that matched or exceeded the quality of more expensive options on those tasks, then reduce spending in my work."}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","meta","3",{"property":"og:title","content":"Model evaluations"}],["$","meta","4",{"property":"og:description","content":"I built a repeatable evaluation suite around SEO tasks I actually do. It helped me choose lower-cost models that matched or exceeded the quality of more expensive options on those tasks, then reduce spending in my work."}],["$","meta","5",{"name":"twitter:card","content":"summary"}],["$","meta","6",{"name":"twitter:title","content":"Model evaluations"}],["$","meta","7",{"name":"twitter:description","content":"I built a repeatable evaluation suite around SEO tasks I actually do. It helped me choose lower-cost models that matched or exceeded the quality of more expensive options on those tasks, then reduce spending in my work."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["projects","model-evals"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"projects","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$",
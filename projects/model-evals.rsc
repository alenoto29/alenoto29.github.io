3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Model evaluations — Alessandro Noto"}],["$","meta","1",{"name":"description","content":"I built an AI-assisted evaluation harness for recurring tasks, with quality thresholds by task family and two model judges. It produced routing recommendations, but I changed teams before applying them to daily work."}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","meta","3",{"property":"og:title","content":"Model evaluations — Alessandro Noto"}],["$","meta","4",{"property":"og:description","content":"I built an AI-assisted evaluation harness for recurring tasks, with quality thresholds by task family and two model judges. It produced routing recommendations, but I changed teams before applying them to daily work."}],["$","meta","5",{"name":"twitter:card","content":"summary"}],["$","meta","6",{"name":"twitter:title","content":"Model evaluations — Alessandro Noto"}],["$","meta","7",{"name":"twitter:description","content":"I built an AI-assisted evaluation harness for recurring tasks, with quality thresholds by task family and two model judges. It produced routing recommendations, but I changed teams before applying them to daily work."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["projects","model-evals"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"projects","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"children":["$","$Lb",null,{"children":["$","$Lc",null,{"children":[["$","$L8",null,{"providerId":"page:/projects/model-evals","segmentMap":{"children":["__PAGE__"]},"children":["$","$L9",null,{"id":"page:/projects/model-evals"}]}],null]}]}]}]}]}]}]}],null,null]
1:[["$","a",null,{"className":"skip-link","href":"#case","children":"Skip to case study"}],["$","header",null,{"className":"nav","children":[["$","a",null,{"className":"brand","href":"/","children":"Alessandro Noto"}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"/#projects","children":"All projects ↗"}],["$","a",null,{"href":"/#about","children":"About"}]]}],["$","span",null,{"className":"edition","children":["CASE / 0",5]}]]}],["$","main",null,{"id":"case","className":"case-page","children":[["$","a",null,{"className":"back-link","href":"/#projects","children":"← Back to projects"}],["$","p",null,{"className":"eyebrow","children":["0",5," / ","TASKS → MODEL CHOICES"]}],["$","h1",null,{"children":"Model evaluations"}],["$","p",null,{"className":"case-lead","children":"I built an AI-assisted evaluation harness for recurring tasks, with quality thresholds by task family and two model judges. It produced routing recommendations, but I changed teams before applying them to daily work."}],["$","div",null,{"className":"case-facts","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"MATURITY"}],["$","p",null,{"children":"Evaluation harness"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"SUPPORTED OUTCOME"}],["$","p",null,{"children":"Recorded evaluations; routing not adopted"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"CONTRIBUTION"}],["$","p",null,{"children":"Built and analysed with AI assistance"}]]}]]}],["$","article",null,{"className":"case-story","children":[["$","h2",null,{"children":"The story"}],[["$","p","0",{"children":"I wanted to know whether recurring work could use less expensive language models without losing the quality each task required. The useful comparison depended on the job: editing HTML, checking report data and reviewing a backend change have different failure costs."}],["$","p","1",{"children":"I built the evaluation harness with AI assistance around cases drawn from that work. Inputs ask models to perform bounded tasks, such as preserving page structure during an edit, producing findings with evidence, or planning outreach without inventing contacts. This connects the evaluation to the work I would actually assign."}],["$","p","2",{"children":"Outputs are assessed against task requirements, domain judgement, scope discipline and format reliability, alongside cost and speed. The proposed routing rule selects the lowest-cost model that meets the quality threshold for a task family. Tasks involving published figures have a higher threshold, while ambiguous or consequential work calls for escalation. These thresholds encode priorities; they are not a guarantee that an accepted output is correct."}],["$","p","3",{"children":"My explicit design choice was to use two model judges and flag substantial disagreement between them. I wanted both assessments visible so one evaluator's preferences would not silently determine every result. Two judges still share the limitations of model-based assessment and may agree on a mistaken judgement. Disagreement flags identify outputs needing attention; agreement alone does not validate them."}],["$","p","4",{"children":"The recorded evaluation contains 84 runs across eight cases from June 2026 and produced recommendations by task family. The results are a historical comparison of those cases, prompts and model versions. They would need to be rerun before informing a current routing decision."}],["$","p","5",{"children":"I changed teams before putting the recommendations into daily use. The outcome was the harness, recorded comparisons and proposed routing choices. No cost saving was realised. The remaining step was operational adoption: deciding how to introduce the recommendations, review failures and keep the evaluation current."}]]]}],"$Ld","$Le"]}],"$Lf"]
d:["$","aside",null,{"className":"case-question","children":[["$","span",null,{"className":"eyebrow","children":"A CONVERSATION WORTH HAVING"}],["$","p",null,{"children":"Why I used two model judges, and how I would investigate their disagreement before trusting a routing recommendation."}]]}]

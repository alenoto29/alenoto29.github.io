1:[["$","a",null,{"className":"skip-link","href":"#case","children":"Skip to case study"}],["$","header",null,{"className":"nav","children":[["$","a",null,{"className":"brand","href":"/","children":"Alessandro Noto"}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"/#projects","children":"All projects ↗"}],["$","a",null,{"href":"/#about","children":"About"}]]}]]}],["$","main",null,{"id":"case","className":"case-page","children":[["$","a",null,{"className":"back-link","href":"/#projects","children":"← Back to projects"}],["$","h1",null,{"children":"Model evaluations"}],["$","p",null,{"className":"case-subtitle","children":"Finding the right model without overpaying"}],["$","p",null,{"className":"case-lead","children":"I built a repeatable evaluation suite around SEO tasks I actually do. It helped me choose lower-cost models that matched or exceeded the quality of more expensive options on those tasks, then reduce spending in my work."}],["$","div",null,{"className":"case-art","children":["$","img",null,{"src":"/images/projects/model-evals.webp","width":"1536","height":"1024","alt":""}]}],["$","article",null,{"className":"case-story","children":[[["$","section","How much model does the job need?",{"children":[["$","h2",null,{"children":"How much model does the job need?"}],[["$","p","0",{"children":[["$","$d","0",{"children":"Using a frontier model for every task is an easy default, but repeated work makes cost and waiting time matter. A cheaper model can also produce a convincing answer while missing a link, changing a price or breaking a page component. I wanted to find where the less expensive option could still meet the requirements."}]]}],["$","p","1",{"children":[["$","$d","0",{"children":"I chose five tasks from my SEO workflows and built the evaluation harness with AI assistance. The fixtures are synthetic, and each task has fixed checks for the output that matters: link relationships, evidence-based page findings, offer updates, constrained HTML edits and supplier calculations."}]]}]]]}],["$","section","Putting quality beside resources",{"children":[["$","h2",null,{"children":"Putting quality beside resources"}],[["$","p","0",{"children":[["$","$d","0",{"children":"I checked the required outputs and model identity before including a run. The overall score is the equal-weight average of the five task scores. "}],["$","strong","1",{"children":"I compare output quality with each session's estimated cost and elapsed time."}],["$","$d","2",{"children":" That makes the trade-offs visible without treating price or model reputation as a proxy for quality."}]]}],["$","p","1",{"children":[["$","$d","0",{"children":"The chart includes only completed runs. Each model has one observation, so small differences could move on a repeat. The checks catch specified errors in facts, arithmetic and structure; they cannot fully assess how well a page reads."}]]}]]]}],["$","section","What changed in my work",{"children":[["$","h2",null,{"children":"What changed in my work"}],[["$","p","0",{"children":[["$","$d","0",{"children":""}],["$","strong","1",{"children":"The highest-scoring run in this suite was not the most expensive, and a substantially cheaper model finished close behind it."}],["$","$d","2",{"children":" For these tasks, better output did not simply follow higher spend or require the newest frontier model."}]]}],["$","p","1",{"children":[["$","$d","0",{"children":"I then used the lower-cost models selected for suitable work, which reduced my model spending. The quality comparison comes from the tested tasks; I cannot quantify the saving as a percentage or claim the same performance for every future task."}]]}]]]}]],["$","details",null,{"className":"case-technical","children":[["$","summary",null,{"children":"Under the hood"}],[["$","p","0",{"children":[["$","$d","0",{"children":""}],["$","strong","1",{"children":"One overall score."}],["$","$d","2",{"children":" Five equally weighted task scores produce a result out of 100."}]]}],"$Le","$Lf"]]}]]}],"$L10","$L11","$L12"]}],"$L13"]

3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Research to report — Alessandro Noto"}],["$","meta","1",{"name":"description","content":"I built an AI-assisted research workflow that separates calculations from writing and keeps human review at key stages. PR colleagues adopted it to produce reports, with the first picked up by national publications."}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","meta","3",{"property":"og:title","content":"Research to report — Alessandro Noto"}],["$","meta","4",{"property":"og:description","content":"I built an AI-assisted research workflow that separates calculations from writing and keeps human review at key stages. PR colleagues adopted it to produce reports, with the first picked up by national publications."}],["$","meta","5",{"name":"twitter:card","content":"summary"}],["$","meta","6",{"name":"twitter:title","content":"Research to report — Alessandro Noto"}],["$","meta","7",{"name":"twitter:description","content":"I built an AI-assisted research workflow that separates calculations from writing and keeps human review at key stages. PR colleagues adopted it to produce reports, with the first picked up by national publications."}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["projects","research-to-report"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"projects","fallback":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"children":["$","$Lb",null,{"children":["$","$Lc",null,{"children":[["$","$L8",null,{"providerId":"page:/projects/research-to-report","segmentMap":{"children":["__PAGE__"]},"children":["$","$L9",null,{"id":"page:/projects/research-to-report"}]}],null]}]}]}]}]}]}]}],null,null]
1:[["$","a",null,{"className":"skip-link","href":"#case","children":"Skip to case study"}],["$","header",null,{"className":"nav","children":[["$","a",null,{"className":"brand","href":"/","children":"Alessandro Noto"}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"/#projects","children":"All projects ↗"}],["$","a",null,{"href":"/#about","children":"About"}]]}],["$","span",null,{"className":"edition","children":["CASE / 0",2]}]]}],["$","main",null,{"id":"case","className":"case-page","children":[["$","a",null,{"className":"back-link","href":"/#projects","children":"← Back to projects"}],["$","p",null,{"className":"eyebrow","children":["0",2," / ","EVIDENCE → NARRATIVE"]}],["$","h1",null,{"children":"Research to report"}],["$","p",null,{"className":"case-lead","children":"I built an AI-assisted research workflow that separates calculations from writing and keeps human review at key stages. PR colleagues adopted it to produce reports, with the first picked up by national publications."}],["$","div",null,{"className":"case-facts","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"MATURITY"}],["$","p",null,{"children":"Team workflow"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"SUPPORTED OUTCOME"}],["$","p",null,{"children":"Adopted by PR colleagues"}]]}],["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"CONTRIBUTION"}],["$","p",null,{"children":"Built and analysed with AI assistance"}]]}]]}],["$","article",null,{"className":"case-story","children":[["$","h2",null,{"children":"The story"}],[["$","p","0",{"children":"The PR team wanted research reports with enough analytical substance to interest newsrooms. We agreed on the initiative together, and I built the workflow from scratch with AI assistance. My responsibility was to turn the team's way of researching, reviewing and writing into a process colleagues could run themselves."}],["$","p","1",{"children":"The central design decision was to calculate report figures with code. Python scripts and spreadsheet models produce named results; writing and chart briefs refer to those results through placeholders. A validator checks that the requested keys exist before generation, and assembly checks that the keys used in text and charts trace back to computed results. An unknown key stops the process."}],["$","p","2",{"children":"I chose this rule in advance because language models can make numerical mistakes. It gives the workflow a checkable connection between calculations and presentation. That connection still needs review: a traceable value can come from a mistaken assumption or be interpreted incorrectly in the narrative."}],["$","p","3",{"children":"People choose the report angle and insights, review the analysis, and review the assembled draft. Review verdicts carry into the next stage without paraphrasing. The analysis correction loop has a fixed limit, so unresolved objections lead to a stop. AI supports building the workflow and generating narrative; deterministic tools handle calculations and validation."}],["$","p","4",{"children":"The hardest part was specifying the depth of analysis and the review sequence clearly enough for repeated use. Colleagues operate the workflow through a topic and decisions at the review stages, without editing its structure."}],["$","p","5",{"children":"The team adopted it, and the first report was picked up by national top-tier publications. I moved to another team afterwards, so I cannot give a current report volume or a sustained placement rate. The supported result is a workflow colleagues could operate and an initial publication outcome; I have no measured traffic or ranking effect to attribute to it."}]]]}],["$","aside",null,{"className":"case-question","children":["$Ld","$Le"]}],"$Lf"]}],"$L10"]
d:["$","span",null,{"className":"eyebrow","children":"A CONVERSATION WORTH HAVING"}]
e:["$","p",null,{"children":"Where I placed human review, and what tracing a published figure back to a calculation can and cannot verify."}]

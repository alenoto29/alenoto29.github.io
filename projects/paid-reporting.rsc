1:[["$","a",null,{"className":"skip-link","href":"#case","children":"Skip to case study"}],["$","header",null,{"className":"nav","children":[["$","a",null,{"className":"brand","href":"/","children":"Alessandro Noto"}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"/#projects","children":"All projects ↗"}],["$","a",null,{"href":"/#about","children":"About"}]]}]]}],["$","main",null,{"id":"case","className":"case-page","children":[["$","a",null,{"className":"back-link","href":"/#projects","children":"← Back to projects"}],["$","h1",null,{"children":"Paid acquisition reporting"}],["$","p",null,{"className":"case-subtitle","children":"A shared basis for budget decisions."}],["$","p",null,{"className":"case-lead","children":"I built a daily dashboard that brings advertising exports and attribution data into one view, with explicit rules for each metric. The app team uses it to monitor acquisition and inform budget allocation."}],["$","div",null,{"className":"case-art","children":["$","img",null,{"src":"/images/projects/paid-reporting.webp","width":"1536","height":"1024","alt":""}]}],["$","article",null,{"className":"case-story","children":[[["$","section","Building the view we were missing",{"children":[["$","h2",null,{"children":"Building the view we were missing"}],[["$","p","0",{"children":[["$","$d","0",{"children":"A new app project needed a shared view of acquisition performance. Advertising spend, installs and in-app activity lived in separate exports. The attribution tool's available tier did not let us bring cost data into the same place."}]]}],["$","p","1",{"children":[["$","$d","0",{"children":"My manager and I agreed to build the missing view. I implemented the dashboard with AI assistance and keep it updated. There was no existing report to replace: this was the team's first shared view of those numbers."}]]}]]]}],["$","section","When the sources disagree",{"children":[["$","h2",null,{"children":"When the sources disagree"}],[["$","p","0",{"children":[["$","$d","0",{"children":"The key decision came from noticing that advertising platforms and the attribution tool reported different install counts for the same dates. "}],["$","strong","1",{"children":"I chose native platform exports as the reference for paid spend and delivery"}],["$","$d","2",{"children":", keeping attributed figures in a separate, labelled view."}]]}],["$","p","1",{"children":[["$","$d","0",{"children":"That distinction shaped the dashboard. Each metric needed an identifiable source and definition. Missing data also needed to remain visible: an export that had not arrived could not silently become a day with zero activity."}]]}],["$","p","2",{"children":[["$","$d","0",{"children":"The pipeline turns source data into consistent daily records, calculates metrics and produces an interactive dashboard. AI helped me build it; the reporting itself runs through deterministic code."}]]}]]]}],["$","section","A tool used across the team",{"children":[["$","h2",null,{"children":"A tool used across the team"}],[["$","p","0",{"children":[["$","$d","0",{"children":""}],["$","strong","1",{"children":"The dashboard became a shared reference for the app team, from leadership to interns."}],["$","$d","2",{"children":" Leadership requested additional metrics, and the team used comparisons of acquisition and in-app action costs to inform advertising-budget allocation."}]]}],["$","p","1",{"children":[["$","$d","0",{"children":"That is the supported outcome: a reporting tool used in real decisions. It does not establish that reallocating the budget improved performance, and the daily view does not measure cohort profitability or the causal effect of advertising."}]]}]]]}]],["$","details",null,{"className":"case-technical","children":[["$","summary",null,{"children":"Under the hood"}],[["$","p","0",{"children":[["$","$d","0",{"children":""}],["$","strong","1",{"children":"From source data to a shared view."}],["$","$d","2",{"children":" Python normalises data from advertising and attribution platforms, calculates metrics and renders an interactive dashboard published behind access control."}]]}],"$Le","$Lf"]]}]]}],false,"$L10","$L11"]}],"$L12"]
e:["$","p","1",{"children":[["$","$d","0",{"children":""}],["$","strong","1",{"children":"Checks before combining sources."}],["$","$d","2",{"children":" Related campaign exports are checked for matching totals. Raw source labels remain intact, while inferred joins and timezone differences carry flags."}]]}]
f:["$","p","2",{"children":[["$","$d","0",{"children":""}],["$","strong","1",{"children":"Missing is different from zero."}],["$","$d","2",{"children":" An absent export, no recorded activity and a recorded zero remain distinguishable. A ratio with a zero denominator is shown as unavailable."}]]}]
10:["$","aside",null,{"className":"case-image-story","children":[["$","h2",null,{"children":"Finding its place"}],[["$","p","0",{"children":[["$","$d","0",{"children":"Overlapping layers remain distinct in the image. The connection is to the reporting itself: sources share a view while keeping the differences that matter for interpreting them."}]]}]]]}]
